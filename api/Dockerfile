# Build from the repo root:  docker build -f api/Dockerfile -t selfsense-api .
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 SELFSENSE_ROOT=/srv
WORKDIR /srv
COPY api/requirements.txt api/requirements.txt
RUN pip install --no-cache-dir -r api/requirements.txt
COPY api/ api/
# published artifacts the API serves (regenerated by the retraining workflow)
COPY app/forecasts.json app/forecasts.json
COPY reports/ reports/
COPY models/registry.json models/registry.json
RUN useradd -m appuser
USER appuser
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s CMD python -c "import urllib.request;urllib.request.urlopen('http://localhost:8000/health')"
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
